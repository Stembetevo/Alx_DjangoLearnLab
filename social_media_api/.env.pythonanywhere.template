# =============================================================================
# PythonAnywhere Environment Configuration Template
# =============================================================================
# Copy this file to .env on PythonAnywhere and fill in your actual values
# DO NOT commit this file to GitHub!
# =============================================================================

# Django Settings
# Generate new SECRET_KEY with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-new-secret-key-here-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=yourusername.pythonanywhere.com

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Choose ONE option below based on your PythonAnywhere account type:

# -----------------------------------------------------------------------------
# OPTION 1: MySQL (for FREE PythonAnywhere accounts)
# -----------------------------------------------------------------------------
# Uncomment these lines if using MySQL:
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=yourusername$socialmedia
# DB_USER=yourusername
# DB_PASSWORD=your-mysql-password-from-pythonanywhere
# DB_HOST=yourusername.mysql.pythonanywhere-services.com

# -----------------------------------------------------------------------------
# OPTION 2: PostgreSQL via ElephantSQL (for paid or external database)
# -----------------------------------------------------------------------------
# Uncomment these lines if using external PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=your-elephantsql-database-name
# DB_USER=your-elephantsql-username
# DB_PASSWORD=your-elephantsql-password
# DB_HOST=your-elephantsql-host.db.elephantsql.com
# DB_PORT=5432

# =============================================================================
# INSTRUCTIONS
# =============================================================================
# 1. Replace 'yourusername' with your actual PythonAnywhere username
# 2. Generate a new SECRET_KEY for production (use the command above)
# 3. Choose MySQL or PostgreSQL configuration
# 4. Fill in your actual database credentials
# 5. Save this file as .env (without .template extension)
# 6. Never commit .env to your GitHub repository!
# =============================================================================
